PORT=3001
# Cloudinary credentials
CLOUD_NAME=
API_KEY=
API_SECRET=
kafka_broker=localhost:9092
# Optional for managed Kafka providers that require SASL_SSL with PLAIN auth
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Google Gemini API key (without it uploads still work and AI routes return 503)
API_KEY_GEMINI=
# Optional: comma-separated model fallback order, fastest first
GEMINI_MODELS=
# Gmail SMTP account used by the send-mail consumer (use an app password)
SMTP_USER=
SMTP_PASS=
