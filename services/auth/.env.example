PORT=3000
# Neon Postgres connection string (shared with user and job services)
DB_URL=
# Must be identical in auth, user and job services
JWT_SEC=
# utils service base URL (used for resume upload on register)
UPLOAD_SERVICE=http://localhost:3001
kafka_broker=localhost:9092
# Optional for managed Kafka providers that require SASL_SSL with PLAIN auth
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Frontend base URL, used in password-reset email links
Frontend_Url=http://localhost:3004
# Redis connection URL (e.g. Upstash rediss://...)
Redis_url=
